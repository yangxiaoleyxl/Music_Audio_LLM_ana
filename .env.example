# Optional: raises Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# Required only when sources.openalex.enabled=true in config/topics.json.
OPENALEX_API_KEY=

# Optional polite-pool identity used by OpenAlex.
OPENALEX_EMAIL=

# Optional: higher Hugging Face Hub API limits; public models work without it.
HF_TOKEN=
